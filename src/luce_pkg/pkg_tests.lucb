import pkg

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    let v = try pkg.parse_version("1.2.3")
    assert(v.major == 1 and v.minor == 2 and v.patch == 3)
    let largest = try pkg.parse_version("18446744073709551615.18446744073709551615.18446744073709551615")
    assert(largest.major == 18446744073709551615 and largest.minor == largest.major and largest.patch == largest.major)
    for oversized in ["18446744073709551616", "30000000000000000000", "36893488147419103231", "9999999999999999999999999999999999999999"]:
        for component in 0..<3:
            var buffer: u8[128]
            let text = try format(buffer, f"{oversized}.0.0" if component == 0 else (f"0.{oversized}.0" if component == 1 else f"0.0.{oversized}"))
            var rejected = false
            discard(pkg.parse_version(text) catch failure:
                assert(failure.code == pkg.invalid)
                rejected = true
                recover pkg.Version(0, 0, 0))
            assert(rejected)
            var candidates: pkg.Candidate[1]
            candidates[0] = pkg.Candidate(name = "acme/demo", version = text)
            rejected = false
            discard(pkg.select_caret("acme/demo", "0.0.0", candidates, 1) catch failure:
                assert(failure.code == pkg.invalid)
                rejected = true
                recover pkg.Version(0, 0, 0))
            assert(rejected)
            var lock_buffer: u8[512]
            let document = try format(lock_buffer, f"schema_version = 1\norigin = \"registry\"\n[[package]]\nname = \"acme/demo\"\nversion = \"{text}\"\ndigest = \"ab\"\ncompiler = \"luce-base\"\n")
            rejected = false
            var invalid_lock = pkg.decode_lock(document) catch failure:
                assert(failure.code == pkg.invalid)
                rejected = true
                recover pkg.Lock()
            invalid_lock.close()
            assert(rejected)
    var failed = false
    discard(pkg.parse_version("01.2.3") catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Version(0, 0, 0))
    assert(failed)
    failed = false
    discard(pkg.parse_version("1.2.3-beta") catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Version(0, 0, 0))
    assert(failed)
    var catalog: pkg.Candidate[4]
    catalog[0] = pkg.Candidate(name = "acme/demo", version = "1.1.0")
    catalog[1] = pkg.Candidate(name = "acme/demo", version = "1.2.5")
    catalog[2] = pkg.Candidate(name = "acme/demo", version = "2.0.0")
    catalog[3] = pkg.Candidate(name = "other/x", version = "1.9.0")
    let chosen = try pkg.select_caret("acme/demo", "1.2.0", catalog, 4)
    assert(chosen.major == 1 and chosen.minor == 2 and chosen.patch == 5)
    failed = false
    discard(pkg.select_caret("acme/demo", "3.0.0", catalog, 4) catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Version(0, 0, 0))
    assert(failed)
    var zero_catalog: pkg.Candidate[3]
    zero_catalog[0] = pkg.Candidate(name = "acme/zero", version = "0.1.0")
    zero_catalog[1] = pkg.Candidate(name = "acme/zero", version = "0.1.9")
    zero_catalog[2] = pkg.Candidate(name = "acme/zero", version = "0.2.0")
    let zero = try pkg.select_caret("acme/zero", "0.1.0", zero_catalog, 3)
    assert(zero.major == 0 and zero.minor == 1 and zero.patch == 9)
    let version_text: str[4] = ["2.0.0", "1.9.3", "1.2.5", "0.9.0"]
    var version_wire: u8[128]
    let version_size = try pkg.encode_versions(version_text, version_text.length, version_wire)
    var versions = try pkg.decode_versions(version_wire[..<version_size])
    assert(versions.count == 4 and try versions.at(0) == "2.0.0" and try versions.at(3) == "0.9.0")
    assert(try pkg.select_version(versions, "^1.2.0") == "1.9.3")
    assert(try pkg.select_version(versions, "1.2.5") == "1.2.5")
    for unavailable in ["^3.0.0", "1.2.4", "^0.8.0", "", "^", "^01.0.0"]:
        failed = false
        discard(pkg.select_version(versions, unavailable) catch failure:
            assert(failure.code == pkg.invalid)
            failed = true
            recover "")
        assert(failed)
    for i in 0..<version_wire.length: version_wire[i] = 173
    let unsorted: str[2] = ["1.0.0", "2.0.0"]
    failed = false
    discard(pkg.encode_versions(unsorted, 2, version_wire) catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover 0)
    assert(failed)
    for byte in version_wire: assert(byte == 173)
    let malformed_catalogs: str[2] = ["BAD!\0\0", "LPV1\0\0x"]
    for malformed_catalog in malformed_catalogs:
        failed = false
        discard(pkg.decode_versions(malformed_catalog.bytes) catch failure:
            assert(failure.code == pkg.invalid)
            failed = true
            recover pkg.Versions())
        assert(failed)
    var truncated_catalog: u8[8]
    truncated_catalog[0] = 'L'
    truncated_catalog[1] = 'P'
    truncated_catalog[2] = 'V'
    truncated_catalog[3] = '1'
    truncated_catalog[4] = 1
    for length in [6, 7, 8]:
        truncated_catalog[6] = 4
        truncated_catalog[7] = '1'
        failed = false
        discard(pkg.decode_versions(truncated_catalog[..<length]) catch failure:
            assert(failure.code == pkg.invalid)
            failed = true
            recover pkg.Versions())
        assert(failed)
    let origin = try pkg.lock_origin("schema_version = 1\norigin = \"https://pkg.luciaos.com\"\n")
    assert(origin == "https://pkg.luciaos.com")
    var packages: pkg.Package[1]
    packages[0] = pkg.Package(name = "acme/demo", version = pkg.Version(1, 2, 3), digest = "ab", compiler = "luce-base")
    var encoded: u8[512]
    let n = try pkg.encode_lock("https://pkg.luciaos.com", packages, 1, encoded)
    assert(try pkg.lock_origin((str)encoded[..<n]) == "https://pkg.luciaos.com")
    var decoded = try pkg.decode_lock((str)encoded[..<n])
    defer decoded.close()
    assert(decoded.count == 1 and decoded.packages[0].name == "acme/demo")
    assert(decoded.packages[0].version.patch == 3)
    for i in 0..<n: encoded[i] = 0
    assert(decoded.origin == "https://pkg.luciaos.com")
    assert(decoded.packages[0].compiler == "luce-base")
    assert(decoded.schema_version == 1 and decoded.packages[0].commit.length == 0)
    packages[0].commit = "0123456789012345678901234567890123456789"
    packages[0].toolchain = "0.20.0"
    let v2_size = try pkg.encode_lock("https://pkg.luciaos.com", packages, 1, encoded, 2)
    var v2 = try pkg.decode_lock((str)encoded[..<v2_size])
    defer v2.close()
    assert(v2.schema_version == 2 and v2.packages[0].commit == packages[0].commit)
    assert(v2.packages[0].toolchain == "0.20.0")
    packages[0].toolchain = "30000000000000000000.0.0"
    for i in 0..<encoded.length: encoded[i] = 173
    failed = false
    discard(pkg.encode_lock("https://pkg.luciaos.com", packages, 1, encoded, 2) catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover 0)
    assert(failed)
    for byte in encoded: assert(byte == 173)
    packages[0].toolchain = "0.20.0"
    failed = false
    discard(pkg.encode_lock("https://pkg.luciaos.com", packages, 1, encoded) catch:
        failed = true
        recover 0)
    assert(failed)
    for bad in ["", "1", "ABCDEF0123456789012345678901234567890123", "012345678901234567890123456789012345678g"]:
        packages[0].commit = bad
        failed = false
        discard(pkg.encode_lock("https://pkg.luciaos.com", packages, 1, encoded, 2) catch:
            failed = true
            recover 0)
        assert(failed)
    packages[0].commit = ""
    packages[0].toolchain = ""
    for bad in [
        "schema_version = 2\norigin = \"a\"\n[[package]]\nname = \"x\"\nversion = \"1.0.0\"\ndigest = \"ab\"\ncompiler = \"luce\"\n",
        "schema_version = 1\norigin = \"a\"\n[[package]]\ncommit = \"0123456789012345678901234567890123456789\"\n"]:
        failed = false
        var rejected = pkg.decode_lock(bad) catch:
            failed = true
            recover pkg.Lock()
        rejected.close()
        assert(failed)
    let malformed: str[8] = [
        "# origin = \"attacker\"\n",
        "schema_version = 3\norigin = \"https://pkg.luciaos.com\"\n",
        "schema_version = 1\norigin = \"a\"\norigin = \"b\"\n",
        "schema_version = 1\norigin = \"a\"\n[[package]]\nname = \"x\"\n",
        "schema_version = 1\norigin = \"a\"\nunknown = 1\n",
        "schema_version = 1\norigin = \"a\" trailing\n",
        "schema_version = 1\norigin = \"a\\b\"\n",
        "schema_version = 1\norigin = \"a\"\n[other]\norigin = \"b\"\n"]
    for text in malformed:
        failed = false
        discard(pkg.lock_origin(text) catch failure:
            assert(failure.code == pkg.invalid)
            failed = true
            recover "")
        assert(failed)
    failed = false
    discard(pkg.select_caret("acme/demo", "1.2.0", catalog, 5) catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Version(0, 0, 0))
    assert(failed)
    let malicious: str[4] = ["bad\"value", "bad\\value", "bad\nvalue", "bad\tvalue"]
    for value in malicious:
        for field in 0..<4:
            packages[0].name = value if field == 1 else "acme/demo"
            packages[0].digest = value if field == 2 else "ab"
            packages[0].compiler = value if field == 3 else "luce-base"
            for i in 0..<encoded.length: encoded[i] = 173
            failed = false
            discard(pkg.encode_lock(value if field == 0 else "https://pkg.luciaos.com", packages, 1, encoded) catch failure:
                assert(failure.code == pkg.invalid)
                failed = true
                recover 0)
            assert(failed)
            for byte in encoded: assert(byte == 173)
    var digest: u8[32]
    assert(try pkg.source_digest(b"abc", digest) == 32)
    assert(digest[0] == 0xba and digest[1] == 0x78 and digest[2] == 0x16 and digest[31] == 0xad)
    print("PASS semver caret resolve and luc.lock origin parse")
    return 0
