import pkg

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    let v = try pkg.parse_version("1.2.3")
    assert(v.major == 1 and v.minor == 2 and v.patch == 3)
    var failed = false
    discard(pkg.parse_version("01.2.3") catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Version(0, 0, 0))
    assert(failed)
    failed = false
    discard(pkg.parse_version("1.2.3-beta") catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Version(0, 0, 0))
    assert(failed)
    var catalog: pkg.Candidate[4]
    catalog[0] = pkg.Candidate(name = "acme/demo", version = "1.1.0")
    catalog[1] = pkg.Candidate(name = "acme/demo", version = "1.2.5")
    catalog[2] = pkg.Candidate(name = "acme/demo", version = "2.0.0")
    catalog[3] = pkg.Candidate(name = "other/x", version = "1.9.0")
    let chosen = try pkg.select_caret("acme/demo", "1.2.0", catalog, 4)
    assert(chosen.major == 1 and chosen.minor == 2 and chosen.patch == 5)
    failed = false
    discard(pkg.select_caret("acme/demo", "3.0.0", catalog, 4) catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Version(0, 0, 0))
    assert(failed)
    var zero_catalog: pkg.Candidate[3]
    zero_catalog[0] = pkg.Candidate(name = "acme/zero", version = "0.1.0")
    zero_catalog[1] = pkg.Candidate(name = "acme/zero", version = "0.1.9")
    zero_catalog[2] = pkg.Candidate(name = "acme/zero", version = "0.2.0")
    let zero = try pkg.select_caret("acme/zero", "0.1.0", zero_catalog, 3)
    assert(zero.major == 0 and zero.minor == 1 and zero.patch == 9)
    let origin = try pkg.lock_origin("schema_version = 1\norigin = \"https://pkg.luciaos.com\"\n")
    assert(origin == "https://pkg.luciaos.com")
    var packages: pkg.Package[1]
    packages[0] = pkg.Package(name = "acme/demo", version = pkg.Version(1, 2, 3), digest = "ab", compiler = "luce-base")
    var encoded: u8[512]
    let n = try pkg.encode_lock("https://pkg.luciaos.com", packages, 1, encoded)
    assert(try pkg.lock_origin((str)encoded[..<n]) == "https://pkg.luciaos.com")
    var decoded = try pkg.decode_lock((str)encoded[..<n])
    defer decoded.close()
    assert(decoded.count == 1 and decoded.packages[0].name == "acme/demo")
    assert(decoded.packages[0].version.patch == 3)
    for i in 0..<n: encoded[i] = 0
    assert(decoded.origin == "https://pkg.luciaos.com")
    assert(decoded.packages[0].compiler == "luce-base")
    let malformed: str[8] = [
        "# origin = \"attacker\"\n",
        "schema_version = 2\norigin = \"https://pkg.luciaos.com\"\n",
        "schema_version = 1\norigin = \"a\"\norigin = \"b\"\n",
        "schema_version = 1\norigin = \"a\"\n[[package]]\nname = \"x\"\n",
        "schema_version = 1\norigin = \"a\"\nunknown = 1\n",
        "schema_version = 1\norigin = \"a\" trailing\n",
        "schema_version = 1\norigin = \"a\\b\"\n",
        "schema_version = 1\norigin = \"a\"\n[other]\norigin = \"b\"\n"]
    for text in malformed:
        failed = false
        discard(pkg.lock_origin(text) catch failure:
            assert(failure.code == pkg.invalid)
            failed = true
            recover "")
        assert(failed)
    failed = false
    discard(pkg.select_caret("acme/demo", "1.2.0", catalog, 5) catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Version(0, 0, 0))
    assert(failed)
    let malicious: str[4] = ["bad\"value", "bad\\value", "bad\nvalue", "bad\tvalue"]
    for value in malicious:
        for field in 0..<4:
            packages[0].name = value if field == 1 else "acme/demo"
            packages[0].digest = value if field == 2 else "ab"
            packages[0].compiler = value if field == 3 else "luce-base"
            for i in 0..<encoded.length: encoded[i] = 173
            failed = false
            discard(pkg.encode_lock(value if field == 0 else "https://pkg.luciaos.com", packages, 1, encoded) catch failure:
                assert(failure.code == pkg.invalid)
                failed = true
                recover 0)
            assert(failed)
            for byte in encoded: assert(byte == 173)
    var digest: u8[32]
    assert(try pkg.source_digest(b"abc", digest) == 32)
    assert(digest[0] == 0xba and digest[1] == 0x78 and digest[2] == 0x16 and digest[31] == 0xad)
    print("PASS semver caret resolve and luc.lock origin parse")
    return 0
