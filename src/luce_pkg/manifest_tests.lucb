import pkg

func rejected(release: pkg.Release, text: str) -> bool:
    pkg.validate_release_manifest(release, text) catch failure:
        assert(failure.code == pkg.invalid)
        return true
    return false

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    var digest: u8[32]
    let base = pkg.Release(origin = "https://pkg.luciaos.com", package = "acme/demo", version = "1.2.3",
        commit = "0123456789012345678901234567890123456789", source_digest = digest,
        compiler = "luce-base", toolchain = "0.20.0")
    var dependencies: pkg.Dependency[2]
    dependencies[0] = pkg.Dependency(package = "acme/core", requirement = "^1.2.0")
    dependencies[1] = pkg.Dependency(package = "tools/render-kit", requirement = "2.0.1")
    var wire: u8[24576]
    let size = try pkg.encode_release_v2(base, "demo", dependencies, 2, wire)
    let release = try pkg.decode_release(wire[..<size])
    let valid = "# compiler-compatible manifest\n[package]\nlanguage = \"luce-base\"\nname = \"demo\" # retained comment\n\n[exports]\ndemo = \"demo\"\n\n[registry.dependencies]\n\"tools/render-kit\" = \"2.0.1\"\n\"acme/core\" = \"^1.2.0\"\n"
    try pkg.validate_release_manifest(release, valid)
    # Source order is not metadata order; comparison is set-canonical.
    try pkg.validate_release_manifest(release, "[registry.dependencies]\n\"tools/render-kit\" = \"2.0.1\"\n\"acme/core\" = \"^1.2.0\"\n[package]\nname = \"demo\"\nlanguage = \"luce-base\"\n")
    let invalid: str[12] = [
        "",
        "[package]\nname = \"demo\"\nlanguage = \"luce-base\"\n",
        "[package]\nname = \"other\"\nlanguage = \"luce-base\"\n[registry.dependencies]\n\"acme/core\" = \"^1.2.0\"\n\"tools/render-kit\" = \"2.0.1\"\n",
        "[package]\nname = \"demo\"\nlanguage = \"luce\"\n[registry.dependencies]\n\"acme/core\" = \"^1.2.0\"\n\"tools/render-kit\" = \"2.0.1\"\n",
        "[package]\nname = \"demo\"\nname = \"demo\"\nlanguage = \"luce-base\"\n",
        "[package]\nname = \"demo\"\nlanguage = \"luce-base\"\nlanguage = \"luce-base\"\n",
        "[package]\nname = \"demo\"\nlanguage = \"luce-base\"\n[registry.dependencies]\n\"acme/core\" = \"^1.2.0\"\n\"acme/core\" = \"^1.2.0\"\n",
        "[package]\nname = \"demo\"\nlanguage = \"luce-base\"\n[registry.dependencies]\n\"Bad/core\" = \"^1.2.0\"\n\"tools/render-kit\" = \"2.0.1\"\n",
        "[package]\nname = \"demo\"\nlanguage = \"luce-base\"\n[registry.dependencies]\n\"acme/core\" = \"^01.2.0\"\n\"tools/render-kit\" = \"2.0.1\"\n",
        "[package]\nname = \"demo\"\nlanguage = \"luce-base\"\n[registry.dependencies]\n\"acme/core\" = \"^1.2.0\"\n\"tools/render-kit\" = \"2.0.2\"\n",
        "[package]\nname = \"demo\"\nlanguage = \"luce-base\"\n[registry.dependencies]\n\"acme/core\" = \"^1.2.0\"\n[registry.dependencies]\n\"tools/render-kit\" = \"2.0.1\"\n",
        "[package]\nname = \"demo\" trailing\nlanguage = \"luce-base\"\n"]
    for text in invalid: assert(rejected(release, text))
    var legacy_wire: u8[1600]
    let legacy_size = try pkg.encode_release(base, legacy_wire)
    assert(rejected(try pkg.decode_release(legacy_wire[..<legacy_size]), valid))
    print("PASS LRS2 manifest identity and dependency agreement")
    return 0
