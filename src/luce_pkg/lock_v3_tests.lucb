import pkg

let source_a = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
let source_b = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
let source_c = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
let publisher = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
let commit = "0123456789012345678901234567890123456789"

func expect_encode_rejected(packages: const pkg.Package[]):
    var output: u8[16384]
    for i in 0..<output.length: output[i] = 173
    var failed = false
    discard(pkg.encode_lock("https://pkg.luciaos.com", packages, packages.length, output, 3) catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover 0)
    assert(failed)
    for byte in output: assert(byte == 173)

func expect_decode_rejected(text: str):
    var failed = false
    var value = pkg.decode_lock(text) catch failure:
        assert(failure.code == pkg.invalid)
        failed = true
        recover pkg.Lock()
    value.close()
    assert(failed)

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    var dependencies_a: pkg.LockedDependency[2]
    dependencies_a[0] = pkg.LockedDependency(package = "acme/b", requirement = "^1.2.0", version = pkg.Version(1, 5, 0))
    dependencies_a[1] = pkg.LockedDependency(package = "acme/c", requirement = "2.0.0", version = pkg.Version(2, 0, 0))
    var dependencies_b: pkg.LockedDependency[1]
    dependencies_b[0] = pkg.LockedDependency(package = "acme/c", requirement = "^2.0.0", version = pkg.Version(2, 0, 0))
    var no_dependencies: pkg.LockedDependency[1]
    var packages: pkg.Package[3]
    packages[0] = pkg.Package(name = "acme/a", version = pkg.Version(1, 1, 0), digest = source_a,
        compiler = "luce-base", commit = commit, toolchain = "0.20.0", package_name = "a",
        root = ".", publisher_key_sha256 = publisher, dependencies = dependencies_a)
    packages[1] = pkg.Package(name = "acme/b", version = pkg.Version(1, 5, 0), digest = source_b,
        compiler = "luce-base", commit = commit, toolchain = "0.20.0", package_name = "b",
        root = ".", publisher_key_sha256 = publisher, dependencies = dependencies_b)
    packages[2] = pkg.Package(name = "acme/c", version = pkg.Version(2, 0, 0), digest = source_c,
        compiler = "luce", commit = commit, toolchain = "0.20.0", package_name = "c",
        root = ".", publisher_key_sha256 = publisher, dependencies = no_dependencies[..<0])
    var encoded: u8[16384]
    let size = try pkg.encode_lock("https://pkg.luciaos.com", packages, packages.length, encoded, 3)
    assert((str)encoded[..<18] == "schema_version = 3")
    assert(try pkg.lock_origin((str)encoded[..<size]) == "https://pkg.luciaos.com")
    var decoded = try pkg.decode_lock((str)encoded[..<size])
    defer decoded.close()
    assert(decoded.schema_version == 3 and decoded.count == 3)
    assert(decoded.packages[0].name == "acme/a" and decoded.packages[0].package_name == "a")
    assert(decoded.packages[0].dependencies.length == 2)
    assert(decoded.packages[0].dependencies[0].package == "acme/b")
    assert(decoded.packages[0].dependencies[0].requirement == "^1.2.0")
    assert(decoded.packages[0].dependencies[0].version.minor == 5)
    assert(decoded.packages[1].dependencies.length == 1 and decoded.packages[2].dependencies.length == 0)
    assert(decoded.packages[2].compiler == "luce" and decoded.packages[2].root == ".")
    assert(decoded.packages[2].publisher_key_sha256 == publisher)
    for i in 0..<size: encoded[i] = 0
    assert(decoded.origin == "https://pkg.luciaos.com" and decoded.packages[0].digest == source_a)
    var roundtrip: u8[16384]
    let roundtrip_size = try pkg.encode_lock(decoded.origin, decoded.packages, decoded.count, roundtrip, 3)
    assert(roundtrip_size == size)
    # The first encoding was erased; regenerate and compare canonical bytes.
    let regenerated = try pkg.encode_lock("https://pkg.luciaos.com", packages, packages.length, encoded, 3)
    assert(regenerated == roundtrip_size)
    for i in 0..<regenerated: assert(encoded[i] == roundtrip[i])
    # A syntactically valid edge mutation must be rejected by decode-time graph
    # validation, independently of the model-side encoder checks below.
    let edge = b"[[package.dependency]]\npackage = \"acme/b\""
    var edge_at = regenerated
    for i in 0..<regenerated - edge.length + 1:
        var matches = true
        for j in 0..<edge.length:
            if encoded[i + j] != edge[j]: matches = false
        if matches:
            edge_at = i
            break
    assert(edge_at < regenerated)
    encoded[edge_at + edge.length - 2] = 'x'
    expect_decode_rejected((str)encoded[..<regenerated])
    encoded[edge_at + edge.length - 2] = 'b'

    # V1/V2 cannot silently discard graph fields.
    var legacy: u8[16384]
    for schema in [1, 2]:
        var failed = false
        discard(pkg.encode_lock("https://pkg.luciaos.com", packages, packages.length, legacy, (u8)schema) catch:
            failed = true
            recover 0)
        assert(failed)

    # Every graph invariant is checked before output mutation.
    let saved_a = packages[0]
    let saved_b = packages[1]
    packages[0] = saved_b
    packages[1] = saved_a
    expect_encode_rejected(packages)
    packages[0] = saved_a
    packages[1] = saved_b
    packages[0].digest = "aa"
    expect_encode_rejected(packages)
    packages[0].digest = source_a
    packages[0].publisher_key_sha256 = "ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
    expect_encode_rejected(packages)
    packages[0].publisher_key_sha256 = publisher
    packages[0].root = "src"
    expect_encode_rejected(packages)
    packages[0].root = "."
    packages[1].package_name = "a"
    expect_encode_rejected(packages)
    packages[1].package_name = "b"
    dependencies_a[0].package = "acme/missing"
    expect_encode_rejected(packages)
    dependencies_a[0].package = "acme/b"
    dependencies_a[0].version = pkg.Version(1, 4, 0)
    expect_encode_rejected(packages)
    dependencies_a[0].version = pkg.Version(1, 5, 0)
    dependencies_a[0].requirement = "^2.0.0"
    expect_encode_rejected(packages)
    dependencies_a[0].requirement = "^1.2.0"
    let first = dependencies_a[0]
    dependencies_a[0] = dependencies_a[1]
    dependencies_a[1] = first
    expect_encode_rejected(packages)
    dependencies_a[1] = dependencies_a[0]
    dependencies_a[0] = first
    var cycle: pkg.LockedDependency[1]
    cycle[0] = pkg.LockedDependency(package = "acme/a", requirement = "^1.0.0", version = pkg.Version(1, 1, 0))
    packages[2].dependencies = cycle
    expect_encode_rejected(packages)
    packages[2].dependencies = no_dependencies[..<0]

    # Table ordering and complete fields are structural, not optional hints.
    expect_decode_rejected("schema_version = 3\norigin = \"x\"\n[[package.dependency]]\npackage = \"a/b\"\nrequirement = \"1.0.0\"\nversion = \"1.0.0\"\n")
    expect_decode_rejected("schema_version = 3\norigin = \"x\"\n[[package]]\nname = \"a/b\"\n")
    var short: u8[32]
    for i in 0..<short.length: short[i] = 173
    var short_failed = false
    discard(pkg.encode_lock("https://pkg.luciaos.com", packages, packages.length, short, 3) catch:
        short_failed = true
        recover 0)
    assert(short_failed)
    for byte in short: assert(byte == 173)
    print("PASS canonical graph-complete luc.lock v3")
    return 0
