## LRS1/LRS2 release metadata. The caller supplies an independently trusted
## publisher key. LRS2 additionally signs compiler identity and dependencies.
import crypto_native
from luce_pkg.semver import parse, invalid

pub let max_dependencies: usize = 128
pub let max_dependency_wire: usize = 20992
pub let max_metadata: usize = 24576

pub struct Dependency:
    pub var package: str
    pub var requirement: str

pub struct Release:
    pub var origin: str
    pub var package: str
    pub var version: str
    pub var commit: str
    pub var source_digest: const u8[]
    ## Source language: `luce-base` or `luce`.
    pub var compiler: str
    pub var toolchain: str
    ## Zero on legacy programmatic values means LRS1; decoders return 1 or 2.
    pub var schema_version: u8
    ## LRS2 compiler package identity, matching `[package] name` in luce.toml.
    pub var package_name: str
    ## LRS2 canonical dependency entries after the u16 count; borrowed from wire.
    var dependency_wire: const u8[]
    pub var dependency_count: usize

    ## Borrowed LRS2 dependency at index.
    pub func dependency_at(index: usize) -> Dependency!:
        if self.schema_version != 2 or index >= self.dependency_count:
            error(invalid, "release dependency index out of bounds")
        var offset: usize
        for i in 0..<(index + 1):
            let package = try take(self.dependency_wire, &offset)
            let wanted = try take(self.dependency_wire, &offset)
            if i == index: return Dependency(package = package, requirement = wanted)
        error(invalid, "release dependency index out of bounds")

func checked_text(value: str) -> !:
    if value.length == 0 or value.length > 256:
        error(invalid, "release text length outside bounds")
    for byte in value.bytes:
        if byte < 33 or byte > 126:
            error(invalid, "release text must be printable ASCII without whitespace")

func coordinate(value: str) -> !:
    if value.length < 3 or value.length > 97: error(invalid, "invalid package coordinate")
    var slash = value.length
    for i in 0..<value.length:
        if value.bytes[i] == '/':
            if slash != value.length: error(invalid, "invalid package coordinate")
            slash = i
    if slash == 0 or slash > 32 or slash == value.length or value.length - slash - 1 > 64:
        error(invalid, "invalid package coordinate")
    for i in 0..<slash:
        let byte = value.bytes[i]
        if not ((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '_'):
            error(invalid, "invalid package owner")
    for i in slash + 1..<value.length:
        let byte = value.bytes[i]
        let alnum = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')
        if not alnum and (i == slash + 1 or (byte != '_' and byte != '-')):
            error(invalid, "invalid package name")

func identifier(value: str) -> !:
    if value.length == 0 or value.length > 128: error(invalid, "invalid compiler package identity")
    for i in 0..<value.length:
        let byte = value.bytes[i]
        let letter = byte >= 'a' and byte <= 'z'
        if not letter and byte != '_' and (i == 0 or byte < '0' or byte > '9'):
            error(invalid, "invalid compiler package identity")

func requirement(value: str) -> !:
    if value.length == 0 or value.length > 63: error(invalid, "invalid dependency requirement")
    let version = (str)value.bytes[1..] if value.bytes[0] == '^' else value
    discard(try parse(version))

func lexical(left: str, right: str) -> i32:
    let shared = left.length if left.length < right.length else right.length
    for i in 0..<shared:
        if left.bytes[i] < right.bytes[i]: return -1
        if left.bytes[i] > right.bytes[i]: return 1
    if left.length < right.length: return -1
    if left.length > right.length: return 1
    return 0

func field(out: u8[], offset: usize*, value: str):
    let n = value.length
    out[*offset] = (u8)(n & 255)
    out[*offset + 1] = (u8)(n >> 8)
    *offset += 2
    for byte in value.bytes:
        out[*offset] = byte
        *offset += 1

func take(wire: const u8[], offset: usize*) -> str!:
    if *offset > wire.length or wire.length - *offset < 2: error(invalid, "truncated release length")
    let n = (usize)wire[*offset] | ((usize)wire[*offset + 1] << 8)
    *offset += 2
    if n == 0 or n > 256 or n > wire.length - *offset: error(invalid, "invalid release field length")
    let value = (str)wire[*offset..<*offset + n]
    *offset += n
    return value

func common(release: Release) -> !:
    for value in [release.origin, release.package, release.version, release.commit, release.compiler, release.toolchain]:
        try checked_text(value)
    try coordinate(release.package)
    discard(try parse(release.version))
    if release.commit.length != 40: error(invalid, "release commit must be a SHA-1 Git object ID")
    for byte in release.commit.bytes:
        if not ((byte >= '0' and byte <= '9') or (byte >= 'a' and byte <= 'f')):
            error(invalid, "release commit must be lowercase hexadecimal")
    if release.compiler != "luce" and release.compiler != "luce-base": error(invalid, "unknown release compiler")
    discard(try parse(release.toolchain))
    if release.source_digest.length != 32: error(invalid, "release requires SHA-256 source digest")

func dependency_bytes(release_package: str, dependencies: const Dependency[], count: usize, out: u8[]) -> usize!:
    if count > dependencies.length or count > max_dependencies: error(invalid, "release dependency count exceeds limit")
    var required: usize
    var previous = ""
    for i in 0..<count:
        let dependency = dependencies[i]
        try coordinate(dependency.package)
        try requirement(dependency.requirement)
        if dependency.package == release_package: error(invalid, "release cannot depend on itself")
        if i > 0 and lexical(previous, dependency.package) >= 0:
            error(invalid, "release dependencies must be unique and sorted")
        previous = dependency.package
        required += 4 + dependency.package.length + dependency.requirement.length
    if required > max_dependency_wire or out.length < required: error(invalid, "release dependency output too small")
    var offset: usize
    for i in 0..<count:
        field(out, &offset, dependencies[i].package)
        field(out, &offset, dependencies[i].requirement)
    return offset

func validate_dependency_wire(release: Release) -> usize!:
    if release.dependency_count > max_dependencies: error(invalid, "release dependency count exceeds limit")
    var offset: usize
    var previous = ""
    for i in 0..<release.dependency_count:
        let package = try take(release.dependency_wire, &offset)
        let required = try take(release.dependency_wire, &offset)
        try coordinate(package)
        try requirement(required)
        if package == release.package: error(invalid, "release cannot depend on itself")
        if i > 0 and lexical(previous, package) >= 0:
            error(invalid, "release dependencies must be unique and sorted")
        previous = package
    if offset != release.dependency_wire.length or offset > max_dependency_wire:
        error(invalid, "release dependency framing invalid")
    return offset

## LRS1 remains available for existing callers. A manually constructed zero schema
## is treated as legacy schema 1. LRS2 values normally come from decode().
pub func encode(release: Release, out: u8[]) -> usize!:
    try common(release)
    let schema: u8 = 1 if release.schema_version == 0 else release.schema_version
    if schema != 1 and schema != 2: error(invalid, "unknown release metadata schema")
    if schema == 1 and (release.package_name.length != 0 or release.dependency_count != 0 or release.dependency_wire.length != 0):
        error(invalid, "LRS1 cannot represent compiler identity or dependencies")
    var required: usize = 6 + 32
    let fields = [release.origin, release.package, release.version, release.commit, release.compiler, release.toolchain]
    for value in fields: required += 2 + value.length
    var dependency_size: usize
    if schema == 2:
        try checked_text(release.package_name)
        try identifier(release.package_name)
        dependency_size = try validate_dependency_wire(release)
        required += 2 + release.package_name.length + 2 + dependency_size
    if required > (1600 if schema == 1 else max_metadata) or out.length < required:
        error(invalid, "release output too small")
    out[0] = 'L'
    out[1] = 'R'
    out[2] = 'S'
    out[3] = '1' if schema == 1 else '2'
    out[4] = schema
    out[5] = 0
    var offset: usize = 6
    for value in fields: field(out, &offset, value)
    if schema == 2: field(out, &offset, release.package_name)
    for byte in release.source_digest:
        out[offset] = byte
        offset += 1
    if schema == 2:
        out[offset] = (u8)(release.dependency_count & 255)
        out[offset + 1] = (u8)(release.dependency_count >> 8)
        offset += 2
        for byte in release.dependency_wire:
            out[offset] = byte
            offset += 1
    return offset

## Construct canonical LRS2 directly from typed dependency declarations. All
## validation precedes output mutation.
pub func encode_v2(release: Release, package_name: str, dependencies: const Dependency[], count: usize, out: u8[]) -> usize!:
    var wire: u8[max_dependency_wire]
    let size = try dependency_bytes(release.package, dependencies, count, wire)
    var value = release
    value.schema_version = 2
    value.package_name = package_name
    value.dependency_wire = wire[..<size]
    value.dependency_count = count
    return try encode(value, out)

## All views borrow wire; callers must retain it unchanged for the view lifetime.
pub func decode(wire: const u8[]) -> Release!:
    if wire.length < 6: error(invalid, "release metadata size outside bounds")
    var schema: u8
    if wire[0] == 'L' and wire[1] == 'R' and wire[2] == 'S' and wire[3] == '1' and wire[4] == 1 and wire[5] == 0:
        schema = 1
        if wire.length < 50 or wire.length > 1600: error(invalid, "release metadata size outside bounds")
    elif wire[0] == 'L' and wire[1] == 'R' and wire[2] == 'S' and wire[3] == '2' and wire[4] == 2 and wire[5] == 0:
        schema = 2
        if wire.length < 54 or wire.length > max_metadata: error(invalid, "release metadata size outside bounds")
    else:
        error(invalid, "unknown release metadata schema")
    var fields: str[7]
    var offset: usize = 6
    let field_count: usize = 6 if schema == 1 else 7
    for i in 0..<field_count: fields[i] = try take(wire, &offset)
    if wire.length - offset < 32: error(invalid, "release digest is truncated")
    let digest = wire[offset..<offset + 32]
    offset += 32
    var count: usize
    var dependency_wire: const u8[]
    if schema == 1:
        if offset != wire.length: error(invalid, "release digest or trailing bytes invalid")
    else:
        if wire.length - offset < 2: error(invalid, "release dependency count is truncated")
        count = (usize)wire[offset] | ((usize)wire[offset + 1] << 8)
        offset += 2
        dependency_wire = wire[offset..]
    let result = Release(origin = fields[0], package = fields[1], version = fields[2], commit = fields[3],
        compiler = fields[4], toolchain = fields[5], source_digest = digest, schema_version = schema,
        package_name = fields[6] if schema == 2 else "", dependency_wire = dependency_wire,
        dependency_count = count)
    var canonical: u8[max_metadata]
    let size = try encode(result, canonical)
    if size != wire.length or not crypto_native.equal(canonical[..<size], wire):
        error(invalid, "noncanonical release metadata")
    return result

pub func verify(release: Release, trusted_key: const u8[], signature: const u8[], source: const u8[]) -> bool!:
    if trusted_key.length != 1952 or signature.length != 3309: return false
    var metadata: u8[max_metadata]
    let size = try encode(release, metadata)
    if not try crypto_native.mldsa_verify(trusted_key, metadata[..<size], signature): return false
    var actual: u8[32]
    discard(try crypto_native.digest(source, actual, "sha256"))
    return crypto_native.equal(actual, release.source_digest)
