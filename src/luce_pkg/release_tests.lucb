import pkg
import crypto_native

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    var seed: u8[32]
    var pk: u8[1952]
    var sk: u8[4032]
    defer crypto_native.wipe(sk)
    try crypto_native.mldsa_keygen(seed, pk, sk)
    var digest: u8[32]
    discard(try pkg.source_digest(b"source fixture", digest))
    var release = pkg.Release(origin = "https://pkg.luciaos.com", package = "acme/demo", version = "1.2.3", commit = "0123456789012345678901234567890123456789", source_digest = digest, compiler = "luce-base", toolchain = "0.20.0")
    var wire: u8[1600]
    let size = try pkg.encode_release(release, wire)
    assert(wire[0] == 'L' and wire[3] == '1' and wire[4] == 1 and wire[5] == 0)
    assert(wire[6] == release.origin.length and wire[7] == 0)
    let parsed = try pkg.decode_release(wire[..<size])
    assert(parsed.package == release.package and parsed.commit == release.commit)
    assert(crypto_native.equal(parsed.source_digest, digest))
    for length in 0..<size:
        var rejected = false
        discard(pkg.decode_release(wire[..<length]) catch failure:
            assert(failure.code == pkg.invalid)
            rejected = true
            recover pkg.Release())
        assert(rejected)
    wire[size] = 0
    var trailing_rejected = false
    discard(pkg.decode_release(wire[..<size + 1]) catch failure:
        assert(failure.code == pkg.invalid)
        trailing_rejected = true
        recover pkg.Release())
    assert(trailing_rejected)
    for position in [0, 4, 6, 7]:
        let old = wire[position]
        wire[position] = 255
        var rejected = false
        discard(pkg.decode_release(wire[..<size]) catch failure:
            assert(failure.code == pkg.invalid)
            rejected = true
            recover pkg.Release())
        assert(rejected)
        wire[position] = old
    var rnd: u8[32]
    var signature: u8[3309]
    try crypto_native.mldsa_sign(sk, wire[..<size], rnd, signature)
    assert(try pkg.verify_release(release, pk, signature, b"source fixture"))
    assert(try pkg.verify_release(parsed, pk, signature, b"source fixture"))
    assert(parsed.schema_version == 1 and parsed.package_name.length == 0 and parsed.dependency_count == 0)
    var dependency_index_rejected = false
    discard(parsed.dependency_at(0) catch failure:
        assert(failure.code == pkg.invalid)
        dependency_index_rejected = true
        recover pkg.Dependency())
    assert(dependency_index_rejected)

    # LRS2 signs the compiler package identity and a canonical dependency set.
    var dependencies: pkg.Dependency[2]
    dependencies[0] = pkg.Dependency(package = "acme/core", requirement = "^1.2.0")
    dependencies[1] = pkg.Dependency(package = "tools/render-kit", requirement = "2.0.1")
    var v2_wire: u8[24576]
    let v2_size = try pkg.encode_release_v2(release, "demo", dependencies, dependencies.length, v2_wire)
    assert((str)v2_wire[..<4] == "LRS2" and v2_wire[4] == 2 and v2_wire[5] == 0)
    let v2 = try pkg.decode_release(v2_wire[..<v2_size])
    assert(v2.schema_version == 2 and v2.package_name == "demo" and v2.dependency_count == 2)
    let first = try v2.dependency_at(0)
    let second = try v2.dependency_at(1)
    assert(first.package == "acme/core" and first.requirement == "^1.2.0")
    assert(second.package == "tools/render-kit" and second.requirement == "2.0.1")
    dependency_index_rejected = false
    discard(v2.dependency_at(2) catch failure:
        assert(failure.code == pkg.invalid)
        dependency_index_rejected = true
        recover pkg.Dependency())
    assert(dependency_index_rejected)
    var v2_signature: u8[3309]
    try crypto_native.mldsa_sign(sk, v2_wire[..<v2_size], rnd, v2_signature)
    assert(try pkg.verify_release(v2, pk, v2_signature, b"source fixture"))
    # A same-length valid dependency mutation still decodes, but cannot verify.
    var requirement_at = v2_size
    while requirement_at > 0 and v2_wire[requirement_at - 1] != '1': requirement_at -= 1
    assert(requirement_at > 0)
    v2_wire[requirement_at - 1] = '2'
    let changed_dependency = try pkg.decode_release(v2_wire[..<v2_size])
    assert(not try pkg.verify_release(changed_dependency, pk, v2_signature, b"source fixture"))
    v2_wire[requirement_at - 1] = '1'
    assert(try pkg.verify_release(try pkg.decode_release(v2_wire[..<v2_size]), pk, v2_signature, b"source fixture"))
    for length in 0..<v2_size:
        var rejected = false
        discard(pkg.decode_release(v2_wire[..<length]) catch failure:
            assert(failure.code == pkg.invalid)
            rejected = true
            recover pkg.Release())
        assert(rejected)
    v2_wire[v2_size] = 0
    trailing_rejected = false
    discard(pkg.decode_release(v2_wire[..<v2_size + 1]) catch failure:
        assert(failure.code == pkg.invalid)
        trailing_rejected = true
        recover pkg.Release())
    assert(trailing_rejected)

    var invalid_dependencies: pkg.Dependency[2]
    for kind in 0..<7:
        invalid_dependencies[0] = pkg.Dependency(package = "acme/core", requirement = "^1.2.0")
        invalid_dependencies[1] = pkg.Dependency(package = "tools/render-kit", requirement = "2.0.1")
        var package_name = "demo"
        var count: usize = 2
        if kind == 0:
            invalid_dependencies[0].package = "tools/render-kit"
            invalid_dependencies[1].package = "acme/core"
        elif kind == 1: invalid_dependencies[1].package = "acme/core"
        elif kind == 2: invalid_dependencies[0].package = "acme/demo"
        elif kind == 3: invalid_dependencies[0].package = "Bad/core"
        elif kind == 4: invalid_dependencies[0].requirement = "^01.2.0"
        elif kind == 5: package_name = "Bad-Name"
        else: count = 3
        for i in 0..<v2_wire.length: v2_wire[i] = 173
        var rejected = false
        discard(pkg.encode_release_v2(release, package_name, invalid_dependencies, count, v2_wire) catch failure:
            assert(failure.code == pkg.invalid)
            rejected = true
            recover 0)
        assert(rejected)
        for byte in v2_wire: assert(byte == 173)
    var excessive_dependencies: pkg.Dependency[129]
    for i in 0..<v2_wire.length: v2_wire[i] = 173
    var excessive_rejected = false
    discard(pkg.encode_release_v2(release, "demo", excessive_dependencies, excessive_dependencies.length, v2_wire) catch failure:
        assert(failure.code == pkg.invalid)
        excessive_rejected = true
        recover 0)
    assert(excessive_rejected)
    for byte in v2_wire: assert(byte == 173)

    # Untrusted dependency counts and entry lengths are checked before indexing.
    discard(try pkg.encode_release_v2(release, "demo", dependencies, dependencies.length, v2_wire))
    var dependency_count_at: usize = 6
    for i in 0..<7:
        let field_size = (usize)v2_wire[dependency_count_at] | ((usize)v2_wire[dependency_count_at + 1] << 8)
        dependency_count_at += 2 + field_size
    dependency_count_at += 32
    assert(v2_wire[dependency_count_at] == 2 and v2_wire[dependency_count_at + 1] == 0)
    for malformed_kind in 0..<2:
        let position = dependency_count_at if malformed_kind == 0 else dependency_count_at + 2
        let old = v2_wire[position]
        v2_wire[position] = 129 if malformed_kind == 0 else 0
        var malformed_rejected = false
        discard(pkg.decode_release(v2_wire[..<v2_size]) catch failure:
            assert(failure.code == pkg.invalid)
            malformed_rejected = true
            recover pkg.Release())
        assert(malformed_rejected)
        v2_wire[position] = old
    var empty_dependencies: pkg.Dependency[1]
    let empty_v2_size = try pkg.encode_release_v2(release, "demo", empty_dependencies[..<0], 0, v2_wire)
    let empty_v2 = try pkg.decode_release(v2_wire[..<empty_v2_size])
    assert(empty_v2.schema_version == 2 and empty_v2.dependency_count == 0)
    assert(not try pkg.verify_release(release, pk, signature, b"changed source"))
    release.origin = "https://other.example"
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    release.origin = "https://pkg.luciaos.com"
    release.version = "1.2.4"
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    release.version = "1.2.3"
    release.package = "acme/other"
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    release.package = "acme/demo"
    release.commit = "1123456789012345678901234567890123456789"
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    release.commit = "0123456789012345678901234567890123456789"
    release.compiler = "luce"
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    release.compiler = "luce-base"
    release.toolchain = "0.21.0"
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    release.toolchain = "0.20.0"
    digest[0] ^= 1
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    digest[0] ^= 1
    pk[0] ^= 1
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    pk[0] ^= 1
    assert(not try pkg.verify_release(release, pk, signature[..<3308], b"source fixture"))
    # All fields restored: rejection above must not have damaged verifier state.
    assert(try pkg.verify_release(release, pk, signature, b"source fixture"))
    for kind in 0..<6:
        var bad = release
        if kind == 0: bad.commit = "012345678901234567890123456789012345678Z"
        elif kind == 1: bad.version = "01.2.3"
        elif kind == 2: bad.compiler = "unknown"
        elif kind == 3: bad.origin = "https://bad\norigin"
        elif kind == 4: bad.source_digest = digest[..<31]
        else: bad.package = ""
        for i in 0..<wire.length: wire[i] = 173
        var rejected = false
        discard(pkg.encode_release(bad, wire) catch failure:
            assert(failure.code == pkg.invalid)
            rejected = true
            recover 0)
        assert(rejected)
        for byte in wire: assert(byte == 173)
    var small: u8[8]
    # Build a canonical, maximum-width valid version then mutate only its digits.
    # The decoder must return invalid, not trap on attacker-controlled wire data.
    var boundary = release
    boundary.version = "18446744073709551615.0.0"
    let boundary_size = try pkg.encode_release(boundary, wire)
    let version_start = 6 + 2 + release.origin.length + 2 + release.package.length + 2
    let overflow_version = "30000000000000000000.0.0"
    for i in 0..<overflow_version.length: wire[version_start + i] = overflow_version.bytes[i]
    var overflow_rejected = false
    discard(pkg.decode_release(wire[..<boundary_size]) catch failure:
        assert(failure.code == pkg.invalid)
        overflow_rejected = true
        recover pkg.Release())
    assert(overflow_rejected)
    for oversized in ["18446744073709551616.0.0", "0.30000000000000000000.0", "0.0.36893488147419103231"]:
        var bad = release
        bad.version = oversized
        for i in 0..<wire.length: wire[i] = 173
        var rejected = false
        discard(pkg.encode_release(bad, wire) catch failure:
            assert(failure.code == pkg.invalid)
            rejected = true
            recover 0)
        assert(rejected)
        for byte in wire: assert(byte == 173)
    for i in 0..<small.length: small[i] = 173
    var short_output = false
    discard(pkg.encode_release(release, small) catch failure:
        assert(failure.code == pkg.invalid)
        short_output = true
        recover 0)
    assert(short_output)
    for byte in small: assert(byte == 173)
    signature[0] ^= 1
    assert(not try pkg.verify_release(release, pk, signature, b"source fixture"))
    assert(not try pkg.verify_release(release, pk[..<1951], signature, b"source fixture"))
    print("PASS native ML-DSA-65 release metadata and SHA-256 source binding")
    return 0
