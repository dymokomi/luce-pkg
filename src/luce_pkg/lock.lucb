## Frozen v1 lockfile: luc.lock TOML, schema_version = 1. Compilers do not read it.
import memory
from luce_pkg.semver import Version, parse, invalid

pub struct Package:
    pub var name: str
    pub var version: Version
    pub var digest: str
    pub var compiler: str

pub struct Lock:
    ## Owned input backing all strings returned by decode().
    var storage: u8[]
    pub var origin: str
    pub var packages: Package[]
    pub var count: usize

    pub mutating func close():
        if self.packages.length > 0: free(self.packages) in memory.heap
        var empty: Package[]
        self.packages = empty
        self.count = 0
        if self.storage.length > 0: free(self.storage) in memory.heap
        var bytes: u8[]
        self.storage = bytes
        self.origin = ""

func write_text(text: u8[], used: usize*, s: str) -> !:
    let n = *used
    if n > text.length or s.length > text.length - n: error(invalid, "lockfile encoding overflow")
    for i in 0..<s.length: text[n + i] = s.bytes[i]
    *used = n + s.length

func write_u64(text: u8[], used: usize*, value: u64) -> !:
    if value == 0:
        try write_text(text, used, "0")
        return
    var digits: u8[20]
    var n: usize
    var v = value
    while v != 0:
        digits[n] = '0' + (u8)(v % 10)
        v = v // 10
        n += 1
    var buf: u8[20]
    var i: usize
    while n > 0:
        n -= 1
        buf[i] = digits[n]
        i += 1
    try write_text(text, used, (str)buf[..<i])

## V1 stores unescaped identifiers/URLs. Reject syntax instead of allowing callers
## to inject new TOML keys/tables. Escaped strings require an owning parser first.
func require_literal(value: str) -> !:
    for byte in value.bytes:
        if byte < 32 or byte == 127 or byte == '"' or byte == '\\':
            error(invalid, "lock field contains unsupported TOML string syntax")

pub func encode(origin: str, packages: const Package[], count: usize, out: u8[]) -> usize!:
    if count > packages.length: error(invalid, "lock package count")
    try require_literal(origin)
    for i in 0..<count:
        try require_literal(packages[i].name)
        try require_literal(packages[i].digest)
        try require_literal(packages[i].compiler)
    var text: u8[4096]
    var n: usize
    try write_text(text, &n, "schema_version = 1\norigin = \"")
    try write_text(text, &n, origin)
    try write_text(text, &n, "\"\n")
    for i in 0..<count:
        try write_text(text, &n, "\n[[package]]\nname = \"")
        try write_text(text, &n, packages[i].name)
        try write_text(text, &n, "\"\nversion = \"")
        try write_u64(text, &n, packages[i].version.major)
        try write_text(text, &n, ".")
        try write_u64(text, &n, packages[i].version.minor)
        try write_text(text, &n, ".")
        try write_u64(text, &n, packages[i].version.patch)
        try write_text(text, &n, "\"\ndigest = \"")
        try write_text(text, &n, packages[i].digest)
        try write_text(text, &n, "\"\ncompiler = \"")
        try write_text(text, &n, packages[i].compiler)
        try write_text(text, &n, "\"\n")
    if out.length < n: error(invalid, "lockfile output is too small")
    for i in 0..<n: out[i] = text[i]
    return n

func trim(value: str) -> str:
    var start: usize
    var end = value.length
    while start < end and (value.bytes[start] == ' ' or value.bytes[start] == '\t' or value.bytes[start] == '\r'):
        start += 1
    while end > start and (value.bytes[end - 1] == ' ' or value.bytes[end - 1] == '\t' or value.bytes[end - 1] == '\r'):
        end -= 1
    if start == end: return ""
    return (str)value.bytes[start..<end]

func literal(value: str) -> str!:
    if value.length < 2 or value.bytes[0] != '"' or value.bytes[value.length - 1] != '"':
        error(invalid, "expected a quoted lock field")
    if value.length == 2: error(invalid, "empty lock field")
    let contents = (str)value.bytes[1..<value.length - 1]
    try require_literal(contents)
    return contents

## Restricted TOML v1 decoder: exact keys, no escapes, no implicit defaults.
## Input strings are borrowed here; public decode makes an owned copy.
func decode_view(text: str) -> Lock!:
    if text.length == 0 or text.length > 1048576:
        error(invalid, "lockfile size outside bounds")
    var capacity: usize
    var start: usize
    for end in 0..<text.length + 1:
        if end != text.length and text.bytes[end] != '\n': continue
        if end > start and trim((str)text.bytes[start..<end]) == "[[package]]":
            capacity += 1
        start = end + 1
    if capacity > 4096: error(invalid, "too many locked packages")
    var result: Lock
    errdefer result.close()
    if capacity > 0: result.packages = try alloc Package[capacity] in memory.heap
    var schema = false
    var origin = false
    var fields: u8
    start = 0
    for end in 0..<text.length + 1:
        if end != text.length and text.bytes[end] != '\n': continue
        let line = trim((str)text.bytes[start..<end]) if end > start else ""
        start = end + 1
        if line.length == 0: continue
        if line.bytes[0] == '#': continue
        if line == "[[package]]":
            if not schema or not origin: error(invalid, "lock header must precede packages")
            if result.count > 0 and fields != 15: error(invalid, "incomplete locked package")
            result.count += 1
            fields = 0
            continue
        var equal = line.length
        for i in 0..<line.length:
            if line.bytes[i] == '=':
                equal = i
                break
        if equal == line.length or equal == 0: error(invalid, "invalid lock assignment")
        let key = trim((str)line.bytes[..<equal])
        let value = trim((str)line.bytes[equal + 1..])
        if result.count == 0:
            if key == "schema_version":
                if schema or value != "1": error(invalid, "invalid or duplicate lock schema")
                schema = true
            elif key == "origin":
                if origin: error(invalid, "duplicate lock origin")
                result.origin = try literal(value)
                origin = true
            else:
                error(invalid, "unknown lock header")
        else:
            var bit: u8
            if key == "name": bit = 1
            elif key == "version": bit = 2
            elif key == "digest": bit = 4
            elif key == "compiler": bit = 8
            else: error(invalid, "unknown package field")
            if (fields & bit) != 0: error(invalid, "duplicate package field")
            fields |= bit
            let contents = try literal(value)
            let index = result.count - 1
            if bit == 1:
                for prior in 0..<index:
                    if result.packages[prior].name == contents: error(invalid, "duplicate locked package")
                result.packages[index].name = contents
            elif bit == 2: result.packages[index].version = try parse(contents)
            elif bit == 4: result.packages[index].digest = contents
            else: result.packages[index].compiler = contents
    if not schema or not origin: error(invalid, "missing lock header")
    if result.count > 0 and fields != 15: error(invalid, "incomplete locked package")
    return result

pub func decode(text: str) -> Lock!:
    if text.length == 0 or text.length > 1048576: error(invalid, "lockfile size outside bounds")
    let owned = try alloc u8[text.length] in memory.heap
    errdefer free(owned) in memory.heap
    memory.copy(owned, text.bytes, text.length)
    var result = try decode_view((str)owned)
    result.storage = owned
    return result

## Validates the entire restricted v1 document; returned origin borrows text.
pub func origin_of(text: str) -> str!:
    var result = try decode_view(text)
    defer result.close()
    return result.origin
