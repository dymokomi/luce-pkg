## Restricted luc.lock TOML v1/v2/v3. Compilers do not read it.
import memory
from luce_pkg.semver import Version, parse, compare, matches_caret, invalid

pub struct LockedDependency:
    pub var package: str
    pub var requirement: str
    pub var version: Version

pub struct Package:
    pub var name: str
    pub var version: Version
    pub var digest: str
    pub var compiler: str
    pub var commit: str
    pub var toolchain: str
    ## V3 compiler identity, current root and publisher-key fingerprint. Trust is external.
    pub var package_name: str
    pub var root: str
    pub var publisher_key_sha256: str
    pub var dependencies: const LockedDependency[]

pub struct Lock:
    ## Owned input backing all strings returned by decode().
    var storage: u8[]
    var dependencies: LockedDependency[]
    pub var origin: str
    pub var packages: Package[]
    pub var count: usize
    pub var schema_version: u8

    pub mutating func close():
        if self.packages.length > 0: free(self.packages) in memory.heap
        var empty: Package[]
        self.packages = empty
        self.count = 0
        if self.dependencies.length > 0: free(self.dependencies) in memory.heap
        var empty_dependencies: LockedDependency[]
        self.dependencies = empty_dependencies
        if self.storage.length > 0: free(self.storage) in memory.heap
        var bytes: u8[]
        self.storage = bytes
        self.origin = ""
        self.schema_version = 0

func write_text(text: u8[], used: usize*, s: str) -> !:
    let n = *used
    if n > text.length or s.length > text.length - n: error(invalid, "lockfile encoding overflow")
    for i in 0..<s.length: text[n + i] = s.bytes[i]
    *used = n + s.length

func release_bytes(bytes: u8[]):
    if bytes.length > 0: free(bytes) in memory.heap

func write_u64(text: u8[], used: usize*, value: u64) -> !:
    if value == 0:
        try write_text(text, used, "0")
        return
    var digits: u8[20]
    var n: usize
    var v = value
    while v != 0:
        digits[n] = '0' + (u8)(v % 10)
        v = v // 10
        n += 1
    var buf: u8[20]
    var i: usize
    while n > 0:
        n -= 1
        buf[i] = digits[n]
        i += 1
    try write_text(text, used, (str)buf[..<i])

## V1 stores unescaped identifiers/URLs. Reject syntax instead of allowing callers
## to inject new TOML keys/tables. Escaped strings require an owning parser first.
func require_literal(value: str) -> !:
    for byte in value.bytes:
        if byte < 32 or byte == 127 or byte == '"' or byte == '\\':
            error(invalid, "lock field contains unsupported TOML string syntax")

func pins(package: Package) -> !:
    if package.commit.length != 40: error(invalid, "lock commit must have 40 hex digits")
    for byte in package.commit.bytes:
        if not ((byte >= '0' and byte <= '9') or (byte >= 'a' and byte <= 'f')):
            error(invalid, "lock commit must be lowercase hexadecimal")
    discard(try parse(package.toolchain))

func lexical(left: str, right: str) -> i32:
    let shared = left.length if left.length < right.length else right.length
    for i in 0..<shared:
        if left.bytes[i] < right.bytes[i]: return -1
        if left.bytes[i] > right.bytes[i]: return 1
    if left.length < right.length: return -1
    if left.length > right.length: return 1
    return 0

func coordinate(value: str) -> !:
    if value.length < 3 or value.length > 97: error(invalid, "invalid locked package coordinate")
    var slash = value.length
    for i in 0..<value.length:
        if value.bytes[i] == '/':
            if slash != value.length: error(invalid, "invalid locked package coordinate")
            slash = i
    if slash == 0 or slash > 32 or slash == value.length or value.length - slash - 1 > 64:
        error(invalid, "invalid locked package coordinate")
    for i in 0..<slash:
        let byte = value.bytes[i]
        if not ((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '_'):
            error(invalid, "invalid locked package owner")
    for i in slash + 1..<value.length:
        let byte = value.bytes[i]
        let alnum = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')
        if not alnum and (i == slash + 1 or (byte != '_' and byte != '-')):
            error(invalid, "invalid locked package name")

func identifier(value: str) -> !:
    if value.length == 0 or value.length > 128: error(invalid, "invalid locked compiler identity")
    for i in 0..<value.length:
        let byte = value.bytes[i]
        let letter = byte >= 'a' and byte <= 'z'
        if not letter and byte != '_' and (i == 0 or byte < '0' or byte > '9'):
            error(invalid, "invalid locked compiler identity")

func hex_digest(value: str, field: str) -> !:
    if value.length != 64: error(invalid, field)
    for byte in value.bytes:
        if not ((byte >= '0' and byte <= '9') or (byte >= 'a' and byte <= 'f')): error(invalid, field)

func satisfies(requirement: str, version: Version) -> bool!:
    if requirement.length == 0: error(invalid, "empty locked dependency requirement")
    if requirement.bytes[0] == '^':
        if requirement.length == 1: error(invalid, "empty locked caret requirement")
        return matches_caret(try parse((str)requirement.bytes[1..]), version)
    return compare(try parse(requirement), version) == 0

func target(packages: const Package[], count: usize, name: str) -> usize?!:
    for i in 0..<count:
        if packages[i].name == name: return i
    return none

func visit(packages: const Package[], count: usize, index: usize, marks: u8[]) -> bool!:
    if marks[index] == 1: return false
    if marks[index] == 2: return true
    marks[index] = 1
    for dependency in packages[index].dependencies:
        let next = (try target(packages, count, dependency.package)) else error(invalid, "locked dependency target is missing")
        if not try visit(packages, count, next, marks): return false
    marks[index] = 2
    return true

func graph(packages: const Package[], count: usize) -> !:
    if count > 256: error(invalid, "v3 locked package count exceeds limit")
    for i in 0..<count:
        let package = packages[i]
        try coordinate(package.name)
        try require_literal(package.name)
        try require_literal(package.digest)
        try require_literal(package.compiler)
        try pins(package)
        try identifier(package.package_name)
        try require_literal(package.package_name)
        if package.root != ".": error(invalid, "v3 package root must be dot")
        try hex_digest(package.digest, "v3 source digest must be 64 lowercase hex digits")
        try hex_digest(package.publisher_key_sha256, "v3 publisher key digest must be 64 lowercase hex digits")
        if package.compiler != "luce" and package.compiler != "luce-base": error(invalid, "invalid locked compiler")
        if i > 0 and lexical(packages[i - 1].name, package.name) >= 0:
            error(invalid, "v3 packages must be unique and sorted")
        for prior in 0..<i:
            if packages[prior].package_name == package.package_name:
                error(invalid, "locked compiler identity has multiple providers")
        if package.dependencies.length > 128: error(invalid, "too many locked package dependencies")
        for j in 0..<package.dependencies.length:
            let dependency = package.dependencies[j]
            try coordinate(dependency.package)
            try require_literal(dependency.package)
            try require_literal(dependency.requirement)
            if dependency.package == package.name: error(invalid, "locked package cannot depend on itself")
            if j > 0 and lexical(package.dependencies[j - 1].package, dependency.package) >= 0:
                error(invalid, "locked dependencies must be unique and sorted")
            if not try satisfies(dependency.requirement, dependency.version):
                error(invalid, "locked dependency version does not satisfy requirement")
            let selected = (try target(packages, count, dependency.package)) else error(invalid, "locked dependency target is missing")
            if compare(packages[selected].version, dependency.version) != 0:
                error(invalid, "locked dependency edge version disagrees with target")
    var marks: u8[256]
    for i in 0..<count:
        if marks[i] == 0 and not try visit(packages, count, i, marks): error(invalid, "locked dependency graph contains a cycle")

pub func encode(origin: str, packages: const Package[], count: usize, out: u8[], schema_version: u8 = 1) -> usize!:
    if schema_version != 1 and schema_version != 2 and schema_version != 3: error(invalid, "unsupported lock schema")
    if count > packages.length: error(invalid, "lock package count")
    try require_literal(origin)
    for i in 0..<count:
        try require_literal(packages[i].name)
        try require_literal(packages[i].digest)
        try require_literal(packages[i].compiler)
        if schema_version >= 2: try pins(packages[i])
        if schema_version < 3 and (packages[i].package_name.length != 0 or packages[i].root.length != 0 or
                                  packages[i].publisher_key_sha256.length != 0 or packages[i].dependencies.length != 0):
            error(invalid, "legacy lock cannot represent graph fields")
        if schema_version == 1 and (packages[i].commit.length != 0 or packages[i].toolchain.length != 0):
            error(invalid, "v1 cannot represent commit/toolchain pins")
    if schema_version == 3: try graph(packages, count)
    let capacity = out.length if out.length < 1048576 else (usize)1048576
    var text: u8[]
    if capacity > 0: text = try alloc u8[capacity] in memory.heap
    defer release_bytes(text)
    var n: usize
    try write_text(text, &n, "schema_version = 3\norigin = \"" if schema_version == 3 else ("schema_version = 2\norigin = \"" if schema_version == 2 else "schema_version = 1\norigin = \""))
    try write_text(text, &n, origin)
    try write_text(text, &n, "\"\n")
    for i in 0..<count:
        try write_text(text, &n, "\n[[package]]\nname = \"")
        try write_text(text, &n, packages[i].name)
        try write_text(text, &n, "\"\nversion = \"")
        try write_u64(text, &n, packages[i].version.major)
        try write_text(text, &n, ".")
        try write_u64(text, &n, packages[i].version.minor)
        try write_text(text, &n, ".")
        try write_u64(text, &n, packages[i].version.patch)
        try write_text(text, &n, "\"\ndigest = \"")
        try write_text(text, &n, packages[i].digest)
        try write_text(text, &n, "\"\ncompiler = \"")
        try write_text(text, &n, packages[i].compiler)
        try write_text(text, &n, "\"\n")
        if schema_version >= 2:
            try write_text(text, &n, "commit = \"")
            try write_text(text, &n, packages[i].commit)
            try write_text(text, &n, "\"\ntoolchain = \"")
            try write_text(text, &n, packages[i].toolchain)
            try write_text(text, &n, "\"\n")
        if schema_version == 3:
            try write_text(text, &n, "package_name = \"")
            try write_text(text, &n, packages[i].package_name)
            try write_text(text, &n, "\"\nroot = \"")
            try write_text(text, &n, packages[i].root)
            try write_text(text, &n, "\"\npublisher_key_sha256 = \"")
            try write_text(text, &n, packages[i].publisher_key_sha256)
            try write_text(text, &n, "\"\n")
            for dependency in packages[i].dependencies:
                try write_text(text, &n, "\n[[package.dependency]]\npackage = \"")
                try write_text(text, &n, dependency.package)
                try write_text(text, &n, "\"\nrequirement = \"")
                try write_text(text, &n, dependency.requirement)
                try write_text(text, &n, "\"\nversion = \"")
                try write_u64(text, &n, dependency.version.major)
                try write_text(text, &n, ".")
                try write_u64(text, &n, dependency.version.minor)
                try write_text(text, &n, ".")
                try write_u64(text, &n, dependency.version.patch)
                try write_text(text, &n, "\"\n")
    if out.length < n: error(invalid, "lockfile output is too small")
    for i in 0..<n: out[i] = text[i]
    return n

func trim(value: str) -> str:
    var start: usize
    var end = value.length
    while start < end and (value.bytes[start] == ' ' or value.bytes[start] == '\t' or value.bytes[start] == '\r'):
        start += 1
    while end > start and (value.bytes[end - 1] == ' ' or value.bytes[end - 1] == '\t' or value.bytes[end - 1] == '\r'):
        end -= 1
    if start == end: return ""
    return (str)value.bytes[start..<end]

func literal(value: str) -> str!:
    if value.length < 2 or value.bytes[0] != '"' or value.bytes[value.length - 1] != '"':
        error(invalid, "expected a quoted lock field")
    if value.length == 2: error(invalid, "empty lock field")
    let contents = (str)value.bytes[1..<value.length - 1]
    try require_literal(contents)
    return contents

func required_fields(schema: u8) -> u16:
    return 511 if schema == 3 else (63 if schema == 2 else 15)

func finish_dependency(active: bool, fields: u8) -> !:
    if active and fields != 7: error(invalid, "incomplete locked dependency")

func finish_package(result: Lock*, fields: u16, dependency_start: usize, dependency_count: usize) -> !:
    if result.count == 0: return
    if fields != required_fields(result.schema_version): error(invalid, "incomplete locked package")
    if result.schema_version >= 2: try pins(result.packages[result.count - 1])
    if result.schema_version == 3 and dependency_count > dependency_start:
        result.packages[result.count - 1].dependencies = result.dependencies[dependency_start..<dependency_count]

## Restricted TOML decoder: exact keys/tables, no escapes or implicit defaults.
## Input strings are borrowed here; public decode makes an owned copy.
func decode_view(text: str) -> Lock!:
    if text.length == 0 or text.length > 1048576:
        error(invalid, "lockfile size outside bounds")
    var capacity: usize
    var dependency_capacity: usize
    var start: usize
    for end in 0..<text.length + 1:
        if end != text.length and text.bytes[end] != '\n': continue
        if end > start:
            let line = trim((str)text.bytes[start..<end])
            if line == "[[package]]": capacity += 1
            elif line == "[[package.dependency]]": dependency_capacity += 1
        start = end + 1
    if capacity > 4096: error(invalid, "too many locked packages")
    if dependency_capacity > 32768: error(invalid, "too many locked dependencies")
    var result: Lock
    errdefer result.close()
    if capacity > 0: result.packages = try alloc Package[capacity] in memory.heap
    if dependency_capacity > 0: result.dependencies = try alloc LockedDependency[dependency_capacity] in memory.heap
    var schema = false
    var origin = false
    var fields: u16
    var dependency_fields: u8
    var in_dependency = false
    var dependency_count: usize
    var dependency_start: usize
    start = 0
    for end in 0..<text.length + 1:
        if end != text.length and text.bytes[end] != '\n': continue
        let line = trim((str)text.bytes[start..<end]) if end > start else ""
        start = end + 1
        if line.length == 0: continue
        if line.bytes[0] == '#': continue
        if line == "[[package]]":
            if not schema or not origin: error(invalid, "lock header must precede packages")
            try finish_dependency(in_dependency, dependency_fields)
            try finish_package(&result, fields, dependency_start, dependency_count)
            result.packages[result.count] = Package()
            result.count += 1
            fields = 0
            dependency_fields = 0
            in_dependency = false
            dependency_start = dependency_count
            continue
        if line == "[[package.dependency]]":
            if result.schema_version != 3 or result.count == 0: error(invalid, "dependency table requires a v3 package")
            if fields != required_fields(3): error(invalid, "package fields must precede dependencies")
            try finish_dependency(in_dependency, dependency_fields)
            result.dependencies[dependency_count] = LockedDependency()
            dependency_count += 1
            dependency_fields = 0
            in_dependency = true
            continue
        var equal = line.length
        for i in 0..<line.length:
            if line.bytes[i] == '=':
                equal = i
                break
        if equal == line.length or equal == 0: error(invalid, "invalid lock assignment")
        let key = trim((str)line.bytes[..<equal])
        let value = trim((str)line.bytes[equal + 1..])
        if result.count == 0:
            if key == "schema_version":
                if schema or (value != "1" and value != "2" and value != "3"):
                    error(invalid, "invalid or duplicate lock schema")
                schema = true
                result.schema_version = 3 if value == "3" else (2 if value == "2" else 1)
            elif key == "origin":
                if origin: error(invalid, "duplicate lock origin")
                result.origin = try literal(value)
                origin = true
            else:
                error(invalid, "unknown lock header")
        elif in_dependency:
            var bit: u8
            if key == "package": bit = 1
            elif key == "requirement": bit = 2
            elif key == "version": bit = 4
            else: error(invalid, "unknown locked dependency field")
            if (dependency_fields & bit) != 0: error(invalid, "duplicate locked dependency field")
            dependency_fields |= bit
            let contents = try literal(value)
            let index = dependency_count - 1
            if bit == 1: result.dependencies[index].package = contents
            elif bit == 2: result.dependencies[index].requirement = contents
            else: result.dependencies[index].version = try parse(contents)
        else:
            var bit: u16
            if key == "name": bit = 1
            elif key == "version": bit = 2
            elif key == "digest": bit = 4
            elif key == "compiler": bit = 8
            elif key == "commit" and result.schema_version >= 2: bit = 16
            elif key == "toolchain" and result.schema_version >= 2: bit = 32
            elif key == "package_name" and result.schema_version == 3: bit = 64
            elif key == "root" and result.schema_version == 3: bit = 128
            elif key == "publisher_key_sha256" and result.schema_version == 3: bit = 256
            else: error(invalid, "unknown package field")
            if (fields & bit) != 0: error(invalid, "duplicate package field")
            fields |= bit
            let contents = try literal(value)
            let index = result.count - 1
            if bit == 1:
                for prior in 0..<index:
                    if result.packages[prior].name == contents: error(invalid, "duplicate locked package")
                result.packages[index].name = contents
            elif bit == 2: result.packages[index].version = try parse(contents)
            elif bit == 4: result.packages[index].digest = contents
            elif bit == 8: result.packages[index].compiler = contents
            elif bit == 16: result.packages[index].commit = contents
            elif bit == 32: result.packages[index].toolchain = contents
            elif bit == 64: result.packages[index].package_name = contents
            elif bit == 128: result.packages[index].root = contents
            else: result.packages[index].publisher_key_sha256 = contents
    if not schema or not origin: error(invalid, "missing lock header")
    try finish_dependency(in_dependency, dependency_fields)
    try finish_package(&result, fields, dependency_start, dependency_count)
    if result.schema_version != 3 and dependency_count != 0: error(invalid, "legacy lock contains dependencies")
    if result.schema_version == 3: try graph(result.packages, result.count)
    return result

pub func decode(text: str) -> Lock!:
    if text.length == 0 or text.length > 1048576: error(invalid, "lockfile size outside bounds")
    let owned = try alloc u8[text.length] in memory.heap
    errdefer free(owned) in memory.heap
    memory.copy(owned, text.bytes, text.length)
    var result = try decode_view((str)owned)
    result.storage = owned
    return result

## Validates the entire restricted v1 document; returned origin borrows text.
pub func origin_of(text: str) -> str!:
    var result = try decode_view(text)
    defer result.close()
    return result.origin
