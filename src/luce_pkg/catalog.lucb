## Canonical bounded immutable-version catalog. Selection is advisory; callers
## must independently verify signed release metadata/source after choosing.
import luce_pkg.semver as semver

pub let max_versions: usize = 1024

pub struct Versions:
    var wire: const u8[]
    pub var count: usize

    ## Borrowed canonical numeric version at index.
    pub func at(index: usize) -> str!:
        if index >= self.count: error(semver.invalid, "catalog version index out of bounds")
        var offset: usize = 6
        for i in 0..<(index + 1):
            let size = (usize)self.wire[offset]
            offset += 1
            if i == index: return (str)self.wire[offset..<offset + size]
            offset += size
        error(semver.invalid, "catalog version index out of bounds")

func descending(versions: const str[], count: usize) -> usize!:
    if count > versions.length or count > max_versions: error(semver.invalid, "catalog version count exceeds limit")
    var required: usize = 6
    var previous: semver.Version
    for i in 0..<count:
        let text = versions[i]
        if text.length == 0 or text.length > 62: error(semver.invalid, "catalog version length outside bounds")
        let parsed = try semver.parse(text)
        if i > 0 and semver.compare(previous, parsed) <= 0:
            error(semver.invalid, "catalog versions must be unique and descending")
        previous = parsed
        required += 1 + text.length
    return required

## Magic LPV1, u16le count, then u8-length canonical numeric versions.
## All validation precedes output mutation.
pub func encode(versions: const str[], count: usize, output: u8[]) -> usize!:
    let required = try descending(versions, count)
    if output.length < required: error(semver.invalid, "catalog output too small")
    output[0] = 'L'
    output[1] = 'P'
    output[2] = 'V'
    output[3] = '1'
    output[4] = (u8)(count & 255)
    output[5] = (u8)(count >> 8)
    var offset: usize = 6
    for i in 0..<count:
        let text = versions[i]
        output[offset] = (u8)text.length
        offset += 1
        for byte in text.bytes:
            output[offset] = byte
            offset += 1
    return offset

## Views borrow `wire`; canonical order and exact framing are validated eagerly.
pub func decode(wire: const u8[]) -> Versions!:
    if wire.length < 6 or wire[0] != 'L' or wire[1] != 'P' or wire[2] != 'V' or wire[3] != '1':
        error(semver.invalid, "unknown package version catalog schema")
    let count = (usize)wire[4] | ((usize)wire[5] << 8)
    if count > max_versions: error(semver.invalid, "catalog version count exceeds limit")
    var offset: usize = 6
    var previous: semver.Version
    for i in 0..<count:
        if offset >= wire.length: error(semver.invalid, "truncated catalog version length")
        let size = (usize)wire[offset]
        offset += 1
        if size == 0 or size > 62 or size > wire.length - offset:
            error(semver.invalid, "invalid catalog version length")
        let parsed = try semver.parse((str)wire[offset..<offset + size])
        if i > 0 and semver.compare(previous, parsed) <= 0:
            error(semver.invalid, "catalog versions must be unique and descending")
        previous = parsed
        offset += size
    if offset != wire.length: error(semver.invalid, "catalog has trailing bytes")
    return Versions(wire = wire, count = count)

## A leading ^ selects the highest compatible version; without ^, require exact.
## Returned text borrows the catalog wire.
pub func select(catalog: Versions, requirement: str) -> str!:
    let caret = requirement.length > 0 and requirement.bytes[0] == '^'
    let text = (str)requirement.bytes[1..] if caret else requirement
    let wanted = try semver.parse(text)
    for i in 0..<catalog.count:
        let candidate_text = try catalog.at(i)
        let candidate = try semver.parse(candidate_text)
        if (caret and semver.matches_caret(wanted, candidate)) or (not caret and semver.compare(wanted, candidate) == 0):
            return candidate_text
    error(semver.invalid, "no catalog version satisfies the requirement")
